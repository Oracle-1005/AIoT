# SQLite database. Defaults to <project-root>/data/aiot.db
AIOT_DB_PATH=

# Model path used by model.inference.GestureClassifier
AIOT_MODEL_PATH=

# Set to 1 only when the Pi 5 Mosquitto broker is reachable
AIOT_MQTT_ENABLED=0
AIOT_MQTT_HOST=127.0.0.1
AIOT_MQTT_PORT=1883
AIOT_MQTT_TOPIC=aiot/gesture

FLASK_DEBUG=1
