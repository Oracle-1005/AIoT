# SQLite database. Defaults to <project-root>/data/aiot.db
AIOT_DB_PATH=

# Flask
FLASK_DEBUG=1
FLASK_PORT=5000

# PC-side TCP + JSON Lines server for the Raspberry Pi
AIOT_PI_GATEWAY_ENABLED=1
AIOT_PI_GATEWAY_HOST=0.0.0.0
AIOT_PI_GATEWAY_PORT=9000
AIOT_PI_GATEWAY_MAX_LINE_BYTES=1048576

# Model path used by model.inference.GestureClassifier
AIOT_MODEL_PATH=

# Keep disabled until the window_features payload is finalized.
AIOT_AUTO_INFER_WINDOW_FEATURES=0

# Sonic Pi OSC adapter. Sonic Pi receives on 127.0.0.1:4560 by default.
AIOT_SONIC_PI_ENABLED=1
AIOT_SONIC_PI_SEND_HOST=127.0.0.1
AIOT_SONIC_PI_SEND_PORT=4560
AIOT_SONIC_PI_LISTEN_HOST=127.0.0.1
AIOT_SONIC_PI_LISTEN_PORT=4561
