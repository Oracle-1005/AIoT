# SQLite database. Defaults to <project-root>/data/aiot.db
AIOT_DB_PATH=

# Flask
FLASK_DEBUG=1
FLASK_PORT=5000

# PC-side TCP + JSON Lines server for the Raspberry Pi
AIOT_PI_GATEWAY_ENABLED=1
AIOT_PI_GATEWAY_HOST=0.0.0.0
AIOT_PI_GATEWAY_PORT=9000
AIOT_PI_GATEWAY_MAX_LINE_BYTES=1048576

# Model path used by model.inference.GestureClassifier
AIOT_MODEL_PATH=

# Compatibility path for direct window_features inference.
AIOT_AUTO_INFER_WINDOW_FEATURES=1
AIOT_INFER_WINDOW_SIZE=30
AIOT_INFER_MIN_CAMERA_FRAMES=15
AIOT_INFER_EVERY_N_FRAMES=3

# Auto led_command on prediction (6.1). Disabled by default; when enabled,
# each prediction meeting the confidence threshold is forwarded to the Pi as
# an led_command. Two-layer throttle (failed sends consume neither):
#   - same gesture repeated within COOLDOWN_S is suppressed (anti-spam);
#   - a different gesture preempts the previous effect immediately after
#     PREEMPT_MIN_S (anti-flicker floor; the Pi consumer preempts natively).
# duration_ms gives the Pi-side timed fallback.
AIOT_LED_AUTO_ENABLED=0
AIOT_LED_AUTO_MIN_CONFIDENCE=0.6
AIOT_LED_AUTO_COOLDOWN_S=1.0
AIOT_LED_AUTO_PREEMPT_MIN_S=0.5
AIOT_LED_AUTO_BRIGHTNESS=0.5
AIOT_LED_AUTO_DURATION_MS=3000
AIOT_LED_AUTO_SKIP_GESTURES=idle

# Sonic Pi OSC adapter. Sonic Pi receives on 127.0.0.1:4560 by default.
AIOT_SONIC_PI_ENABLED=1
AIOT_SONIC_PI_SEND_HOST=127.0.0.1
AIOT_SONIC_PI_SEND_PORT=4560
AIOT_SONIC_PI_LISTEN_HOST=127.0.0.1
AIOT_SONIC_PI_LISTEN_PORT=4561
