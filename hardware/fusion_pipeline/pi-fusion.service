[Unit]
Description=AIoT Fusion Pipeline — ESP32 Gateway + Camera → TCP
Documentation=https://github.com/your-org/aiot-conducting
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ag1_client
WorkingDirectory=/home/ag1_client/aiot_conductor/project/hardware/fusion_pipeline

# Pi monotonic clock (time.monotonic_ns) for sensor fusion
Environment="PYTHONUNBUFFERED=1"

# Use the existing venv
ExecStartPre=/bin/sleep 5
ExecStart=/home/ag1_client/aiot_conductor/project/camera_to_Pi/.venv/bin/python -u /home/ag1_client/aiot_conductor/project/hardware/fusion_pipeline/main.py --config config.yaml

# Restart on failure (ESP32 may take time to reconnect)
Restart=always
RestartSec=10
StartLimitInterval=120
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pi-fusion

# Hardware access (Picamera2/libcamera may use several /dev/video*,
# /dev/media*, dma-buf, and render nodes; avoid a narrow DeviceAllow list.
SupplementaryGroups=video render gpio i2c

[Install]
WantedBy=multi-user.target
