[Unit]
Description=AIoT Fusion Pipeline — ESP32 Gateway + Camera → TCP
Documentation=https://github.com/your-org/aiot-conducting
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ag1_client
WorkingDirectory=/home/ag1_client/aiot_project/hardware/fusion_pipeline

# Pi monotonic clock (time.monotonic_ns) for sensor fusion
Environment="PYTHONUNBUFFERED=1"

# Use the existing venv
ExecStartPre=/bin/sleep 5
ExecStart=/home/ag1_client/aiot_project/venv/bin/python -u /home/ag1_client/aiot_project/hardware/fusion_pipeline/main.py --config config.yaml

# Restart on failure (ESP32 may take time to reconnect)
Restart=always
RestartSec=10
StartLimitInterval=120
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pi-fusion

# Hardware access (camera)
DeviceAllow=/dev/video0 rw
DeviceAllow=/dev/media0 rw
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
