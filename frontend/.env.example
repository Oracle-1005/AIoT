VITE_BACKEND_BASE_URL=http://localhost:5000

# Optional Raspberry Pi camera feed. The frontend does not open the laptop/PC webcam.
# Use these before the backend exposes the same values in:
# GET /api/sensors/live -> camera.stream_url / camera.frame_url.
VITE_CAMERA_STREAM_URL=
VITE_CAMERA_FRAME_URL=

# Optional future WebSocket feed for full frontend frames.
VITE_CONDUCTOR_WS_URL=
