[Unit]
Description=AIoT Pi 5 Flask Dashboard — API + WebSocket + SQLite
Documentation=https://github.com/your-org/aiot-conducting
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/aiot/pi5
Environment="PYTHONUNBUFFERED=1"
Environment="FLASK_HOST=0.0.0.0"
Environment="FLASK_PORT=5000"
Environment="FLASK_DEBUG=0"
Environment="MQTT_BROKER=localhost"
Environment="MQTT_PORT=1883"
Environment="MQTT_ENABLED=1"
Environment="AIOT_DB_PATH=/home/pi/aiot/pi5/pi_dashboard.db"

# Use the venv Python
ExecStartPre=/bin/sleep 5
ExecStart=/home/pi/aiot/pi5/venv/bin/python -u /home/pi/aiot/pi5/pi_flask_app.py

# Restart on failure
Restart=always
RestartSec=5
StartLimitInterval=120
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pi-flask

# Network
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
